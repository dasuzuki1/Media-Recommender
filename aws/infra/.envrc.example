# Copy to .envrc (gitignored) and fill in real values.
# With direnv: `direnv allow` auto-loads when you cd in.
# Without direnv: `source .envrc` manually.

# --- AWS auth ---
export AWS_PROFILE="media-recommender"
export AWS_REGION="us-east-1"

# --- Terraform variables ---
export TF_VAR_aws_region="us-east-1"
export TF_VAR_environment="dev"

# AniList OAuth credentials (https://anilist.co/settings/developer)
export TF_VAR_anilist_client_id="your-anilist-client-id"
export TF_VAR_anilist_client_secret="your-anilist-client-secret"

# Random 32+ byte hex string for signing session cookies
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
export TF_VAR_session_secret="replace-with-real-secret"

# CloudFront URL (or custom domain) of the deployed frontend.
# Chicken-and-egg: first apply uses a placeholder, then update after CloudFront is up.
export TF_VAR_frontend_origin="https://d1234example.cloudfront.net"

# Optional overrides
# export TF_VAR_compute_schedule="rate(1 hour)"
# export TF_VAR_top_n_recommendations="20"
# export TF_VAR_content_weight="0.6"

# --- Remote state backend (shared with monitoring-pipeline) ---
export TF_STATE_BUCKET="your-tf-state-bucket"
export TF_STATE_LOCK_TABLE="terraform-locks"

export TF_CLI_ARGS_init="-backend-config=bucket=${TF_STATE_BUCKET} -backend-config=dynamodb_table=${TF_STATE_LOCK_TABLE} -backend-config=region=${AWS_REGION}"
